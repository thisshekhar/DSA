// https://leetcode.com/problems/palindrome-pairs

public class Solution {
    public IList<IList<int>> PalindromePairs(string[] words) {
        List<IList<int>> ans = new();
        int n = words.Length;
        Dictionary<string,int> dict = new();
        if(n < 2)
        {
            return ans;
        }
        for(int i = 0; i < n; i++)
        {
            dict.Add(string.Concat(words[i].Reverse()),i);
        }

        for(int i = 0; i<n;i++)
        {
            for(int j = 0; j<= words[i].Length; j++)
            {
                string prefix = words[i].Substring(0,j);
                string suffix = words[i].Substring(j);

                if(dict.ContainsKey(prefix) && isPalindrome(suffix) && dict[prefix] != i)
                {
                    ans.Add(new List<int>{ i,dict[prefix] });
                }
                if(!string.IsNullOrEmpty(prefix) && dict.ContainsKey(suffix) && isPalindrome(prefix) && dict[suffix] != i)
                {
                    ans.Add(new List<int>{ dict[suffix],i });
                }
            }
            
        }
        return ans;
    }

    public bool isPalindrome(string s)
    {
        int left=0,right = s.Length - 1;
        while(left < right)
        {
            if(s[left] != s[right])
            {
                return false;
            }
            left++;
            right--;
        }

        return true;
    }
}