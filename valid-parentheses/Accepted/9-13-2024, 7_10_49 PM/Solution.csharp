// https://leetcode.com/problems/valid-parentheses

public class Solution {
    public bool IsValid(string s) {
        Stack<char> stk = new Stack<char>();

        foreach(char c in s)
        {
            if(c == '(' || c == '[' || c == '{')
            {
                stk.Push(c);
            }

            else if(c == ')' || c == ']' || c == '}')
            {
                if(stk.Count == 0)
                {
                    return false;
                }
               
                else if(!isMatching(stk.Pop(),c))
                {
                    return false;
                }
            }
        }

        if(stk.Count > 0)
        {
            return false;
        }

        return true;
    }

    private bool isMatching(char c1, char c2)
    {
        if(c1 == '{' && c2 == '}')
        {
            return true;
        }
         if(c1 == '[' && c2 == ']')
        {
            return true;
        }
         if(c1 == '(' && c2 == ')')
        {
            return true;
        }
        return false;
    }
}