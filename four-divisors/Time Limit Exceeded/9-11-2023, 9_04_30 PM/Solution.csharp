// https://leetcode.com/problems/four-divisors

public class Solution {
    public int SumFourDivisors(int[] nums) {
        int sum = 0;
        for(int i =0; i< nums.Length; i++)
        {
            sum += Sum(nums[i]);
        }
        return sum;
    }

    public int Sum(int num) {
        int count = 0;
        int divisor =1;
        int sum = 0;
        while(true)
        {
            
            if(num % divisor == 0)
            {
                sum += divisor;
                ++count;
            }
            if(num == divisor)
            {
                break;
            }
            divisor++;
        }
        if(count ==4)
        {
            return sum;
        }
        return 0;
    }
}