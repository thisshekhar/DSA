// https://leetcode.com/problems/four-divisors

public class Solution {
    public int SumFourDivisors(int[] nums) {
         int result=0;
        for(int i=0;i<nums.Length;i++)
        {
            int n=nums[i];
            int count=0;
            int sum=0;
            int sqrt=(int)Math.Sqrt(n);
            for(int j=1;j<=sqrt;j++)
            {
                if(n%j==0)
                {
                    count++;
                    sum=sum+j;
                    if(n/j!=j)
                    {
                        count++;
                        sum=sum+(n/j);
                    }
                }
                if(count>4)
                  break;
            }
            if(count==4)
                result=result+sum;
        }
        return result;
    }
}