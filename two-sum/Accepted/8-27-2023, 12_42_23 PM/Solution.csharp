// https://leetcode.com/problems/two-sum

public class Solution {
    public int[] TwoSum(int[] nums, int target) {
        
        int[] res = new int[2];

        res[0] = 0;res[1] = 1;
        if(nums[res[0]] + nums[res[1]] == target)
        {
            return res;
        }

        for(int i = 2; i < nums.Length; i++)
        {
            for(int j = 0; j < i; j++)
            {
                if(nums[i] + nums[j] == target)
                {
                    res[0] = j;
                    res[1] = i;
                    return res;
                }
            }
        }

        return new int[2];
    }
}