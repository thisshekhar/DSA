// https://leetcode.com/problems/decompress-run-length-encoded-list

public class Solution {
    public int[] DecompressRLElist(int[] nums) {
        List<int> res = new();

        for(int  i = 0; i < nums.Length/2; i++)
        {
            int freq = nums[2* i];
            int value = nums[2* i + 1];
            while(freq > 0)
            {
                res.Add(value);
                freq--;
            }
        }

        return res.ToArray();
    }
}