// https://leetcode.com/problems/final-value-of-variable-after-performing-operations

public class Solution {
    public int FinalValueAfterOperations(string[] operations) {
        int X = 0;
        for(int i =0;i<operations.Length;i++)
        {
            switch (operations[i])
            {
                case("--X"):
                    X -= 1;
                    break;
                 case("X--"):
                    X -= 1;  
                    break;
                case("++X"):
                    X += 1;
                    break;
                 case("X++"):
                    X += 1;  
                    break; 
            }

        }
        return X;
    }
}