// https://leetcode.com/problems/max-consecutive-ones

public class Solution {
    public int FindMaxConsecutiveOnes(int[] nums) {
        int result = 0;
        int count = result;
        for(int i = 0 ; i < nums.Length; i++)
        {
            if(nums[i] == 1)
            {
                count++;
            }
            else
            {
                result = Math.Max(count,result);
                count = 0;
            }
        }
        result = Math.Max(count,result);
        return result;
    }
}