// https://leetcode.com/problems/reverse-bits

public class Solution {
    public uint reverseBits(uint n) {
        uint result = 0;
        for(int i = 0; i<32; i++)
        {
            uint lsb = (n & 1);
            uint reverseLsb = lsb << (31-i);
            result = result | reverseLsb;
            n >>= 1;
        }
        return result;
    }
}