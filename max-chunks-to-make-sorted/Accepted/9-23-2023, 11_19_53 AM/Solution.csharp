// https://leetcode.com/problems/max-chunks-to-make-sorted

public class Solution {
    public int MaxChunksToSorted(int[] arr) {
        int chunkCount = 0;
        //int expectedSum = 0;
        int currSum = 0;
        for(int i = 0; i < arr.Length; i++)
        {
            currSum = Math.Max(currSum,arr[i]);
            if(currSum == i)
            {
                chunkCount++;
            }
        }

        return chunkCount;
    }
}