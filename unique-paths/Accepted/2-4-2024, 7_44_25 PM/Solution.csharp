// https://leetcode.com/problems/unique-paths

public class Solution {
    public int UniquePaths(int m, int n) {
    //    if(n==1 || m == 1)
    //    {
    //        return 1;
    //    }
    //    return UniquePaths( m, n-1 )  + UniquePaths( m-1, n ) ;

        int[][] grid = new int[m][];
        for(int i = 0; i < m ; i++)
        {
            grid[i]  = new int[n];
        }

        for(int i = 0; i < m; i++)
        {
            for(int j = 0 ; j < n ; j++)
            {
                if(i == 0 || j == 0)
                {
                    grid[i][j] = 1;
                }
                else
                {
                    grid[i][j] = grid[i-1][j] + grid[i][j-1];
                }
            }
        }

        return grid[m-1][n-1];
    }
}