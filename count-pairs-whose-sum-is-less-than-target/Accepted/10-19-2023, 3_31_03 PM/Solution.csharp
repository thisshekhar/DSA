// https://leetcode.com/problems/count-pairs-whose-sum-is-less-than-target

public class Solution {
    public int CountPairs(IList<int> nums, int target) {
        int res = 0, n = nums.Count;
        for(int i =0; i < n -1; i++ )
        {
            for(int j = i+ 1; j < n; j++)
            {
                if(nums[i] + nums[j] < target)
                {
                    res++;
                }
            }
        }

        return res;
    }
}