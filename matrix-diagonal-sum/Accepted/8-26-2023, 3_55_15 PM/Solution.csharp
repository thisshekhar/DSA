// https://leetcode.com/problems/matrix-diagonal-sum

public class Solution {
    public int DiagonalSum(int[][] mat) {
        int n = mat.Length;
        int result = 0;

        for(int i =0; i < n; i++)
        {
             for(int j =0; j < n; j++)
             {
                if(i==j)
                {
                    result += mat[i][j];
                }

                if(i+j == n-1 && i!=j)
                {
                    result += mat[i][j];
                }
             }
        }
        return result;
    }
}