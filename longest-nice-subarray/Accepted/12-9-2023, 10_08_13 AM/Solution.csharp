// https://leetcode.com/problems/longest-nice-subarray

public class Solution {
    public int LongestNiceSubarray(int[] nums) {
        int res = 1;
        int n = nums.Length;

        for(int i = 0; i < n-1; i++)
        {
            int num = nums[i];
            int count = 1;
           for(int j = i +1; j < n;j++)
            {
                if((num & nums[j]) == 0)
                {
                   
                    count++;
                    if(count > res)
                    {
                        res = count;
                    }
                    
                }
                else
                {
                    break;
                }

                num = num | nums[j];
            }

        }
        return res;
    }
}