// https://leetcode.com/problems/target-sum

public class Solution {
    public int FindTargetSumWays(int[] nums, int target) {
        int range = 0;
        for (int i = 0; i < nums.Length; i++) {
            range += nums[i];
        }
        if (target > range || (range + target) % 2 != 0){ 
            return 0;
        }
        
        // s1+s2 = range;
        // s2-s1 = target;
        // 2*s2 = range + target
        // s2 = (range + target)/2
        
        int sum = Math.Abs((range + target)/2);
        
        //find count of subsets with given sum;
        
        int[,] dp = new int[nums.Length+1,sum+1];
        for (int i=0; i<=nums.Length; i++) {
            dp[i,0] = 1;
        }
        
        for (int i=1; i<=sum; i++) {
            dp[0,i] = 0;
        }
        
        for (int i=1; i<=nums.Length; i++) {
		//j starts from 0, becuase 0s are considered valid in this problem, e.g - nums: [0,0,0,0], target: 0, ans = 16
            for (int j=0; j<=sum; j++) { 
                if (j>= nums[i-1] || nums[i-1] == 0) {
                    dp[i,j] = dp[i-1,j-nums[i-1]] + dp[i-1,j];
                } else {
                    dp[i,j] = dp[i-1,j];
                }
            }
        }
        return dp[nums.Length,sum];
    }
}