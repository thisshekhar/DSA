// https://leetcode.com/problems/contains-duplicate

public class Solution {
    public bool ContainsDuplicate(int[] nums) {
        HashSet<int> hashset = new();

        for(int i = 0; i < nums.Length; i++)
        {
            if(hashset.Contains(nums[i]))
            {
                return true;
            }
            hashset.Add(nums[i]);
        }

        return false;
    }
}