// https://leetcode.com/problems/left-and-right-sum-differences

public class Solution {
    public int[] LeftRightDifference(int[] nums) {
      int n = nums.Length;
        int[] result = new int[n];
        //if only one element is present - result will be '[0]'
        if (n == 1)
            return result;

        //perform prefix-sum
        for (int i = 1; i < n; i++)
            result[i] = result[i - 1] + nums[i - 1];

        //saving suffixSum in a variable
        //and performing operation of |leftSum - rightSum|
        int suffixSum = 0;
        for (int i = n - 2; i >= 0; i--)
        {
            suffixSum += nums[i + 1];
            result[i] = Math.Abs(result[i] - suffixSum);
        }

        return result;
    }
}