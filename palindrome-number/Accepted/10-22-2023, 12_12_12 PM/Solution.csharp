// https://leetcode.com/problems/palindrome-number

public class Solution {
    public bool IsPalindrome(int x) {
        Console.WriteLine(reverse(x));
        return x == reverse(x);
    }

    public int reverse(int x)
    {
        
        int rev = 0;
        while(x > 0)
        {
            int digit = x%10;
            rev = (10 * rev) + digit ;
            x/= 10;
        
        }
        return rev;
    }
}