// https://leetcode.com/problems/reshape-the-matrix

public class Solution {
    public int[][] MatrixReshape(int[][] mat, int r, int c) {
        int n = mat.Length;
		int m = mat[0].Length;
		
		if (m * n != r * c) {
			return mat;
		}
		
		int[][] arr = new int[r][];
		for (int i = 0; i < r; i++) {
			arr[i] = new int[c];
		}
		
		for (int i = 0; i < n; i++) {
			for (int j = 0; j < m; j++) {
				int l = i * m + j;
				arr[l / c][l % c] = mat[i][j];
			}
		}
		
		return arr;
    }
}