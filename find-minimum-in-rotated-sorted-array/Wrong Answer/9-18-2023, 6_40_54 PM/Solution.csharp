// https://leetcode.com/problems/find-minimum-in-rotated-sorted-array

public class Solution {
    public int FindMin(int[] nums) {
        int start = 0 , end = nums.Length -1, ans = int.MaxValue;

        while(start <= end)
        {
            int mid  = (start + end) /2;
            
            if(nums[mid] > nums[0])
            {
                start = mid +1;
            }
            else
            {
                ans = Math.Min(ans,nums[mid]);
                end = mid -1;
            }
        }

        return Math.Min(nums[0],ans);
    }
}