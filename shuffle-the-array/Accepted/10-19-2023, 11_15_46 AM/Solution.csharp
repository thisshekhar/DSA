// https://leetcode.com/problems/shuffle-the-array

public class Solution {
    public int[] Shuffle(int[] nums, int n) {
        int[] res = new int[nums.Length];
        
        for(int i = 0,j=0; i < n; i++,j++)
        {
           
            res[j] = nums[i];
            res[++j] = nums[n+i];
        }
        return res;
    }
}