// https://leetcode.com/problems/magnetic-force-between-two-balls

public class Solution {
    public int MaxDistance(int[] position, int m) {
        Array.Sort(position);
        int s = 0 ,n = position.Length,  e = position[n-1];
        int ans = 0;
        while(s <= e){
            int mid = s + (e-s)/2;
            
            if(isAnswer(position, mid ,m))
            {
                ans = mid; 
                s = mid+1; // if this gap is sufficient enough try widening the gap
                
            }
            else
            {
                e = mid-1; // reduce the gap size 
            }
        }
        return ans;
    }

    public bool isAnswer(int[] A , int mid ,int m ){
        int initial= 1;  // greedily place the first ball 
        int prev = A[0];  // update prev pointer as the ball is being placed here
        for(int i = 1 ; i < A.Length ; i++){
            if(A[i]-prev >= mid){  // if gap is sufficient enough place the ball
                prev = A[i];   //update prev pointer 
                initial+=1;  // increment the no of placable balls
                if(initial == m ) return true;  // all balls placed return true
            }
        }

        // some balls are left to be placed return false
        if(initial < m)
        {
            return false; 
        } 
        return true;
    }
}