// https://leetcode.com/problems/reverse-pairs

public class Solution {
    public int ReversePairs(int[] arr) {
         int cnt = 0;
        int n = arr.Length;
 
        for (int i = 0; i < n; i++)
        {
            for (int j = i + 1; j < n; j++)
            {
                // Condition for reverse pairs
                if (arr[i] > 2 * arr[j])
                {
                    cnt++;
                }
            }
        }
 
        return cnt;
    }
}