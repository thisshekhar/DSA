// https://leetcode.com/problems/ugly-number-ii

public class Solution {
    public int NthUglyNumber(int n) {
        if(n==1)
            return n;
        int t2  = 0, t3 = 0, t5 = 0;
        int[] ans = new int[n];
        ans[0] = 1;
        for(int i =1; i < n; i++)
        {
            ans[i] = Math.Min(ans[t2] * 2 , Math.Min(ans[t3] * 3,ans[t5] * 5));
            if(ans[i] == ans[t2] * 2)
            {
                t2++;
            }
             if(ans[i] == ans[t3] * 3)
            {
                t3++;
            }
             if(ans[i] == ans[t5] * 5)
            {
                t5++;
            }
        }
        return ans[n-1];
    }
}