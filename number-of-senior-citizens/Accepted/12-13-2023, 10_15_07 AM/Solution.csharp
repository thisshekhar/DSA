// https://leetcode.com/problems/number-of-senior-citizens

public class Solution {
    public int CountSeniors(string[] details) {
        int count = 0;
        for(int i = 0; i < details.Length; i++)
        {
            if(Convert.ToInt32(details[i].Substring(11,2)) > 60)
            {
                count++;
            }
        }

        return count;
    }
}