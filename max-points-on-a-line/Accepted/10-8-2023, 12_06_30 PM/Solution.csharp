// https://leetcode.com/problems/max-points-on-a-line

public class Solution {
    public int MaxPoints(int[][] points) {
        int n = points.Length;

        if(n ==1)
            return 1;

        int result = 2;

        for(int i = 0; i < n; i++)
        {
            Dictionary<double, int> dict = new();
            for(int j = 0; j<n; j++)
            {
                if(j != i)
                {
                    var slop = Math.Atan2(points[j][1] - points[i][1], points[j][0] - points[i][0]);
                    dict[slop] = dict.GetValueOrDefault(slop,0) + 1;
                }
            }

            result = Math.Max(result,dict.Values.Max() + 1);
        }
        return result;
    }
}