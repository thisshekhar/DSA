// https://leetcode.com/problems/maximum-subarray

public class Solution {
    public int MaxSubArray(int[] nums) {
        int res = int.MinValue;
        for(int i = 0; i < nums.Length; i++)
        {
            int currSum = 0;
            for(int j = i; j < nums.Length; j++)
            {
                currSum += nums[j];
                res = Math.Max(res,currSum);
            }
        }
        return res;
    }
}