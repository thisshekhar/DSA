// https://leetcode.com/problems/valid-triangle-number

public class Solution {
    public int TriangleNumber(int[] nums) {
        int n = nums.Length,count=0;
        Array.Sort(nums);
        for(int i =0; i < n-2; i++)
        {
            int k = i+2;
            for(int j = i+1; j<n-1 && nums[j] != 0; j++)
            {
                while(k < n && nums[i] + nums[j] > nums[k])
                {
                    k++;
                }

                count += (k-j-1);
            }

        }
        return count;
    }
}