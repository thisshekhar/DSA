// https://leetcode.com/problems/maximum-gap

public class Solution {
    public int MaximumGap(int[] nums) {
        int max = nums[0];
        int min = nums[0];
        int n = nums.Length;

        int ans = 0;
        if(n<2)
        {
            return ans;
        }
        for(int i=1; i < n; i++)
        {
            max = Math.Max(max,nums[i]);
            min = Math.Min(min,nums[i]);
        }

        ans = (int)Math.Ceiling((decimal)(max-min)/(n-1));
        return ans;
    }
}