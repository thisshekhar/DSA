// https://leetcode.com/problems/add-binary

public class Solution {
    public string AddBinary(string a, string b) {
        int n1 = a.Length, n2 = b.Length, carry =0,i=0;
        string res ="";

        while(i < n1 || i < n2 || carry != 0 )
        {
            int A = 0;
            if(i < n1 && a[n1-1-i] == '1')
            {
                A = 1;
            }
            
            int B = 0;
            if(i < n2 && b[n2-1-i] == '1')
            {
                B = 1;
            }

            res = (A + B + carry) % 2 + res;
            carry = (A + B + carry) / 2;

            i++;
        }

        return res;
    }
}