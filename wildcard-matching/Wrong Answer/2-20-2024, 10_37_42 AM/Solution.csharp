// https://leetcode.com/problems/wildcard-matching

public class Solution {
    public bool IsMatch(string s, string p) {
        int n = p.Length;
        int m = s.Length;
        bool[,] dp = new bool[n+1,m+1];

        dp[0,0] = true;

        for(int i = 1; i<=n; i++)
        {
            if(p[i-1] == '*')
            {
                dp[i,0] = dp[i-1,0];
            }
        }

        for(int i = 1; i<=n; i++)
        {
            for(int j = 1; j<= m; j++)
            {
                if(p[i-1] == '*')
                {
                    dp[i,j] = dp[i-1,j] || dp[i,j-1];
                }
                else
                {
                    if(s[j-1] == p[i-1] || p[i-1] == '?')
                    {
                        dp[i,j] = dp[i-1,j];
                    }
                }
            }
            
        }

        return dp[n,m];
    }
}