// https://leetcode.com/problems/number-of-employees-who-met-the-target

public class Solution {
    public int NumberOfEmployeesWhoMetTarget(int[] hours, int target) {
        int employeeCount = 0;
        for(int i = 0; i < hours.Count();i++)
        {
            if(hours[i] >= target)
            {
                employeeCount++;
            }
        }

        return employeeCount;
    }
}