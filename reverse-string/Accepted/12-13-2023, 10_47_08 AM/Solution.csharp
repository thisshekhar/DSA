// https://leetcode.com/problems/reverse-string

public class Solution {
    public void ReverseString(char[] s) {
        int start = 0, end = s.Length-1;
        while(start <= end)
        {
            char temp = s[start];
            s[start] = s[end];
            s[end] = temp;
            start++;
            end--;
        }
    }
}